{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "number",
      "const": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "operation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,99}$"
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source": {
      "default": "disk",
      "type": "string",
      "enum": [
        "disk",
        "editor",
        "runtime"
      ]
    },
    "session": {
      "type": [
        "string",
        "null"
      ]
    },
    "revision": {
      "type": "string"
    },
    "creatorVersion": {
      "type": "string"
    },
    "params": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "formatVersion",
    "requestId",
    "operation",
    "source",
    "params"
  ],
  "additionalProperties": false
}
