{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "project": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "enum": [
        "disk",
        "editor",
        "runtime"
      ]
    },
    "document": {
      "type": "string",
      "minLength": 1
    },
    "session": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "handle": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "format": "starts_with",
      "pattern": "^\\/.*"
    },
    "component": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "ordinal"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "project",
    "source",
    "document",
    "session",
    "revision",
    "handle",
    "path"
  ],
  "additionalProperties": false
}
